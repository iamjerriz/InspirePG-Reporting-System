PORT=3001
MAX_FILE_SIZE_MB=5
CORS_ORIGIN=http://localhost:5173

# Supabase project (Project Settings -> API in the Supabase dashboard).
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security - keep it out of the
# frontend and out of source control. Never use the anon key here.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket that holds proof-of-login images. Created by supabase/schema.sql.
SUPABASE_STORAGE_BUCKET=proofs

# Admin dashboard (/admin) auth - change these before deploying anywhere shared.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Long random string used to sign admin session tokens. If unset, a random
# secret is generated at process start (admin sessions won't survive a restart).
JWT_SECRET=
SESSION_TTL_HOURS=8
